// shaders/sky.mtk — gökyüzü kubbesi: tek saçılmalı atmosfer (Rayleigh + Mie evre fonksiyonları), güneş diski.
// Kameraya ortalanmış büyük bir kürenin iç yüzüne çizilir (demo: draw_sky). Ufuk rengi = sis rengi →
// sisle eriyen zemin gökle dikişsiz birleşir. Uniform'lar LitUniforms yerleşiminde:
// fog_color = ufuk, tint = tepe, to_light = güneş yönü, light_color = güneş rengi.

uniform tex: texture2d;
uniform to_light: vec3;
uniform ambient: f32;
uniform light_color: vec3;
uniform fog_start: f32;
uniform fog_color: vec3;
uniform fog_end: f32;
uniform eye: vec3;
uniform use_mip: i32;
uniform tint: vec3;
uniform wrap: f32;
uniform translucency: f32;

varying wpos: vec3;
varying nrm: vec3;
varying uv: vec2;

fn frag() -> vec4 {
    let dir = normalize(wpos - eye);
    let up = clamp(dir.y, 0.0, 1.0);
    let c = max(dot(dir, to_light), 0.0);
    // saçılma (D48): Rayleigh evre fonksiyonu 3/4 (1 + cos²θ) tepedeki maviyi güneş eksenine göre değiştirir; hava kütlesi ~ 1 / (1 + 7·up)
    // ufukta sis rengine götürür (zemin aynı renge erir, dikişsiz). Pow yok: gök ekranın büyük kısmı
    let rayleigh = 0.75 * (1.0 + c * c);
    let h = 1.0 / (1.0 + 7.0 * up);
    let sky = mix(tint * (0.82 + 0.24 * rayleigh), fog_color, sqrt(h));
    // ufkun altı: sis rengi (zemin zaten sisle bu renge erir)
    let base = select(dir.y >= 0.0, sky, fog_color);
    // Mie saçılması: Henyey-Greenstein evre fonksiyonu (g = 0,8), güneşin çevresinde geniş hale
    let q = 1.64 - 1.6 * c;
    let mie = 0.36 / (q * sqrt(q));
    let halo = mie * 0.018;
    // güneş diski; kenarı kararır (limb darkening): disk içinde merkeze doğru parlaklaşır
    let disk = smoothstep(0.9994, 0.9997, c) * 4.0;
    let glow = (1.0 - up) * (1.0 - up) * c * c * 0.12;
    // geniş yumuşak geçişte 8 bit bantlaşmasın: ±½ basamak titreşim (Jimenez 2014, interleaved gradient noise)
    let fc = frag_coord();
    let ign = fract(52.9829189 * fract(0.06711056 * fc.x + 0.00583715 * fc.y)) - 0.5;
    return vec4(base + light_color * (halo + disk + glow) + vec3(ign / 255.0), 1.0);
}
