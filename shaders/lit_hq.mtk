// shaders/lit_hq.mtk — yüksek kaliteli aydınlatma: anizotropik + trilinear doku süzme, yumuşak diffuse, kumaş
// geçirgenliği, üstel sis. Doku: mip seviyesi KÜÇÜK eksenden (ayak izi ≥ büyük / 8), büyük eksen boyunca 8 çift
// doğrusal örnek, iki komşu seviye arasında kesirli seviyeyle karışım (seviye sınırında görünür bant yok).
// Işık: Lambert ↔ half-Lambert² diffuse + yarım küre ortam + arkadan ışık. Sis: 1 - 2^(-4x²), x = (d - başla) / aralık
// (yumuşak başlar, ufukta gök rengine erir; sky.mtk ile aynı ufuk rengi).
// Gölge (M13 faz 7): gfx3d/shadow.h haritası, f32 derinlik bitleri texel_fetch + bitcast_f32 ile, 2×2 süzmeli karşılaştırma
// (PCF); yalnız doğrudan ışığı keser. Kapalıyken 1×1 / derinlik 2 / shadow_mat = 0 → çarpan tam 1 (çıktı bit-bit aynı).
// Uniform sırası LitUniforms ile aynı (wrap, translucency tint'ten sonra; ardından shadow, shadow_mat, shadow_bias).

uniform tex: texture2d @mipmap @bilinear;
uniform to_light: vec3;
uniform ambient: f32;
uniform light_color: vec3;
uniform fog_start: f32;
uniform fog_color: vec3;
uniform fog_end: f32;
uniform eye: vec3;
uniform use_mip: i32;
uniform tint: vec3;
uniform wrap: f32;
uniform translucency: f32;
uniform shadow: texture2d @clamp;
uniform shadow_mat: mat4;
uniform shadow_bias: f32;

varying wpos: vec3;
varying nrm: vec3;
varying uv: vec2;

fn norm_safe(v: vec3) -> vec3 {
    let l = sqrt(dot(v, v));
    return select(l > 0.0, v * (1.0 / l), v);
}

// anizotropik + trilinear: büyük eksen boyunca 8 örnek (oran en çok 8), her örnek iki seviyede
fn sample_aniso(p: vec2) -> vec4 {
    let ts = tex_size(tex);
    let dx = dFdx(p);
    let dy = dFdy(p);
    let tx = dx * ts;
    let ty = dy * ts;
    let lx = dot(tx, tx);
    let ly = dot(ty, ty);
    let x_major = lx >= ly;
    let major2 = max(lx, ly);
    let minor2 = min(lx, ly);
    let axis = select(x_major, dx, dy);
    // texel cinsinden ayak izi²: küçük eksen, ama büyük eksenin 1/8'inden az değil (8 örnek kapsar)
    let foot2 = max(minor2, major2 * 0.015625);
    let lodf = select(use_mip != 0, 0.5 * log2(max(foot2, 1.0)), 0.0);
    let l0f = floor(lodf);
    let frac = lodf - l0f;
    let l0 = clamp(i32(l0f), 0, 15);
    let l1 = min(l0 + 1, 15);          // son seviyenin ötesi sample_level'da kenetlenir
    var a0 = vec4(0.0);
    var a1 = vec4(0.0);
    for i in 0..8 {
        let q = p + axis * ((f32(i) + 0.5) * 0.125 - 0.5);
        a0 += sample_level(tex, q, l0);
        a1 += sample_level(tex, q, l1);
    }
    return mix(a0, a1, frac) * 0.125;
}

// ışık görüşünden görünür mü: 1 = aydınlık, 0 = gölgede; dört komşu texel'in sonucu çift doğrusal karışır
fn shadow_lit(p: vec3) -> f32 {
    let s = shadow_mat * vec4(p, 1.0);
    let ts = tex_size(shadow);
    let x = s.x * ts.x - 0.5;
    let y = s.y * ts.y - 0.5;
    let fx = floor(x);
    let fy = floor(y);
    let ax = x - fx;
    let ay = y - fy;
    let ix = i32(fx);
    let iy = i32(fy);
    let z = s.z - shadow_bias;
    let l00 = select(z > bitcast_f32(texel_fetch(shadow, ix, iy)), 0.0, 1.0);
    let l10 = select(z > bitcast_f32(texel_fetch(shadow, ix + 1, iy)), 0.0, 1.0);
    let l01 = select(z > bitcast_f32(texel_fetch(shadow, ix, iy + 1)), 0.0, 1.0);
    let l11 = select(z > bitcast_f32(texel_fetch(shadow, ix + 1, iy + 1)), 0.0, 1.0);
    let lit = mix(mix(l00, l10, ax), mix(l01, l11, ax), ay);
    // haritanın dışı (kapsanmayan bölge) aydınlık
    let inside = s.x >= 0.0 && s.x <= 1.0 && s.y >= 0.0 && s.y <= 1.0 && s.z <= 1.0;
    return select(inside, lit, 1.0);
}

fn frag() -> vec4 {
    let texel = sample_aniso(uv);
    let n = norm_safe(nrm);
    let nl = dot(n, to_light);
    // yumuşak diffuse: Lambert ile half-Lambert² arası (wrap = 0 → Lambert, 1 → ((n·l)/2 + 1/2)²).
    // Kare, gölge tarafını kara basmadan kıvrımlardaki eğim farkını korur → kıvrımlar belli olur.
    let h = nl * 0.5 + 0.5;
    let diffuse = mix(max(nl, 0.0), h * h, wrap);
    // arkadan ışık (ters yüz aydınlanır), yumuşak
    let back = max(-nl, 0.0) * translucency;
    let hemi = ambient * (0.75 + 0.25 * n.y);
    let light = vec3(hemi) + light_color * (diffuse * shadow_lit(wpos) + back);
    let c = texel.rgb * tint * light;
    let d = length(wpos - eye);
    let fog_scale = 1.0 / max(fog_end - fog_start, 0.000001);
    let x = max(d - fog_start, 0.0) * fog_scale;
    let f = 1.0 - exp2(-4.0 * x * x);
    return vec4(mix(c, fog_color, f), 1.0);
}
