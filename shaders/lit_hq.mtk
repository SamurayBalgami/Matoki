// shaders/lit_hq.mtk — yüksek kaliteli aydınlatma: anizotropik + trilinear doku süzme, yumuşak diffuse, kumaş
// geçirgenliği, üstel sis. Doku: mip seviyesi KÜÇÜK eksenden (ayak izi ≥ büyük / 4), büyük eksen boyunca oran kadar (1, 2,
// 4) çift doğrusal örnek, iki komşu seviye arasında kesirli seviyeyle karışım (seviye sınırında görünür bant yok).
// Işık: Lambert ↔ half-Lambert² diffuse + yarım küre ortam + arkadan ışık. Sis: 1 - 2^(-4x²), x = (d - başla) / aralık
// (yumuşak başlar, ufukta gök rengine erir; sky.mtk ile aynı ufuk rengi).
// Gölge (M13 faz 7): gfx3d/shadow.h haritası, f32 derinlik bitleri texel_fetch + bitcast_f32 ile, süzmeli karşılaştırma
// (PCF); yalnız doğrudan ışığı keser. Kapalıyken 1×1 / derinlik 2 / shadow_mat = 0 → çarpan tam 1 (çıktı bit-bit aynı).
// Kalite (D45, D46): gölge 4×4 üçüncü derece B-spline, iki kademe, alıcı düzlemi; kabartı doku parlaklığından (Mikkelsen 2010).
// Fizik tabanlı ışık (D48): doğrusal uzayda enerji korunumlu Lambert + GGX (Trowbridge-Reitz dağılımı, Smith görünürlüğü, Schlick Fresnel),
// metal / pürüz iş akışı; çevre yansıması analitik gökten (Karis 2014 yaklaşımı); ACES ton eğrisi, sonra gama; sis görüntü uzayında Beer-Lambert,
// kanal başına sönüm (kısa dalga boyu daha çabuk saçılır). rough ≥ 0,97 malzeme parlak kolu çalıştırmaz, bump 0 kabartı kolunu (D43).
// Bulut (D53): sky.mtk'nin dokusu; güneşi keser, pürüzsüz yüzeye yansır.
// Uniform'lar adla bağlanır (D56, gfx3d/lit_layout.c): sıra serbest, yalnız kullanılanlar. Gölge shadow.mtk'de, bulut ve sis atmos.mtk'de (D57);
// SHADOWS motorca değiştirilir (gölgesiz türev aynı kaynaktan, gölge kodu derlenmez).

import "atmos.mtk";
import "shadow.mtk";

const SHADOWS = true;

uniform tex: texture2d @mipmap @bilinear;
uniform to_light: vec3;
uniform ambient: f32;
uniform light_color: vec3;
uniform fog_color: vec3;
uniform eye: vec3;
uniform use_mip: i32;
uniform tint: vec3;
uniform wrap: f32;
uniform translucency: f32;
uniform metal: f32;
uniform rough: f32;
uniform bump: f32;
uniform field: texture2d @bilinear @clamp;
uniform field_scale: f32;

varying wpos: vec3;
varying nrm: vec3;
varying uv: vec2;

fn norm_safe(v: vec3) -> vec3 {
    let l = sqrt(dot(v, v));
    return select(l > 0.0, v * (1.0 / l), v);
}

// büyük eksen boyunca n eşit aralıklı örnek, ayak izini kapsar
fn axis2(p: vec2, axis: vec2, k: i32) -> vec4 {
    var a = vec4(0.0);
    for i in 0..2 { a += sample_level(tex, p + axis * ((f32(i) + 0.5) * 0.5 - 0.5), k); }
    return a * 0.5;
}
fn axis4(p: vec2, axis: vec2, k: i32) -> vec4 {
    var a = vec4(0.0);
    for i in 0..4 { a += sample_level(tex, p + axis * ((f32(i) + 0.5) * 0.25 - 0.5), k); }
    return a * 0.25;
}
// örnek sayısı quad başına: büyük / küçük eksen oranı kadar (GPU'lardaki gibi). Koşullar quad-sabit → seçilmeyen kol çalışmaz (D43)
fn axis_avg(p: vec2, axis: vec2, k: i32, ratio2: f32) -> vec4 {
    return select(ratio2 <= 1.5, sample_level(tex, p, k), select(ratio2 <= 6.0, axis2(p, axis, k), axis4(p, axis, k)));
}

// anizotropik + trilinear: büyük eksen boyunca en çok 4 örnek (D54: gölgelemenin yarısı buradaydı, taş ve tuğla dokusunda 8 örnekle farkı görünmüyor), her örnek gerekirse iki seviyede
fn sample_aniso(p: vec2) -> vec4 {
    let ts = tex_size(tex);
    let dx = dFdx(p);
    let dy = dFdy(p);
    let tx = dx * ts;
    let ty = dy * ts;
    let lx = dot(tx, tx);
    let ly = dot(ty, ty);
    let x_major = lx >= ly;
    let major2 = max(lx, ly);
    let minor2 = min(lx, ly);
    let axis = select(x_major, dx, dy);
    // texel cinsinden ayak izi²: küçük eksen, ama büyük eksenin 1/4'ünden az değil (4 örnek kapsar)
    let foot2 = max(minor2, major2 * 0.0625);
    let lodf = select((use_mip & 1) != 0, 0.5 * log2(max(foot2, 1.0)), 0.0);
    let l0f = floor(lodf);
    let frac = lodf - l0f;
    let l0 = clamp(i32(l0f), 0, 15);
    let l1 = min(l0 + 1, 15);          // son seviyenin ötesi sample_level'da kenetlenir
    // uzak seviyede (texel başına 8+ piksel ayak izi) doku zaten ortalama, ayrıca sisli: en çok 2 örnek yeter (D52)
    let ratio2 = min(select(foot2 > 0.0, major2 / max(foot2, 0.000001), 1.0), select(l0 >= 3, 4.0, 1000000.0));
    // seviye geçişi yalnız kesrin orta bandında (donanımlardaki "brilinear"): uçlarda tek seviye yeter, örnek sayısı yarıya iner (D50)
    let w = clamp((frac - 0.3) * 2.5, 0.0, 1.0);
    return select(w <= 0.0, axis_avg(p, axis, l0, ratio2),
           select(w >= 1.0, axis_avg(p, axis, l1, ratio2), mix(axis_avg(p, axis, l0, ratio2), axis_avg(p, axis, l1, ratio2), w)));
}

// yükseklik h'nin ekran türevlerinden bozulmuş normal: n - bump · (yüzeydeki yükseklik eğimi). Türevler çağıranda: türevli kol GPU'da
// dallanamaz (D43), kabartısız zemin de bu hesabı öderdi
fn bump_normal(n: vec3, px: vec3, py: vec3, hx: f32, hy: f32) -> vec3 {
    let r1 = cross(py, n);
    let r2 = cross(n, px);
    let det = dot(px, r1);
    let g = (r1 * hx + r2 * hy) * select(det < 0.0, -1.0, 1.0);
    return norm_safe(n * abs(det) - g * bump);
}

// pah yüksekliği (D58): uv kenarına uzaklık e (yüz kesri). Genişlik en az BEVEL_W, uzakta en az ~1,5 piksel (foot = uv'nin piksel başına
// değişimi): ince bant ekranda noktalı ışık çizgisine dönmez. Profil q²: kenarda eğim sınırlı (çeyrek dairede sonsuzdu, kenar sert bir
// çizgi yakıyordu). Bant ayak izine göre genişleyince derinliği aynı oranda azalır: uzakta pah eğimi söner, yakında aynı kalır
const BEVEL_W = 0.05;
fn bevel(p: vec2, foot: vec2) -> f32 {
    let f = fract(p);
    let e = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
    let w = max(BEVEL_W, max(foot.x, foot.y) * 1.5);
    let q = clamp(1.0 - e * (1.0 / w), 0.0, 1.0);
    return -q * q * (BEVEL_W / w);
}

// analitik gök (sky.mtk ile aynı renkler, doğrusal): pürüz yansımayı ortalama göğe bulandırır, ufuk altı zemin
fn sky_linear(r: vec3, a: f32) -> vec3 {
    let up = clamp(r.y, 0.0, 1.0);
    let h = 1.0 / (1.0 + 7.0 * up);
    let fc = fog_color * fog_color;
    let sky = mix(vec3(0.102, 0.27, 0.74), fc, h * h);
    let above = mix(sky, vec3(0.35, 0.47, 0.72), a);
    // ufuk çizgisi pürüz kadar bulanır (dikey metal yüzeyde sert sınır olmasın)
    let band = 0.04 + a * 0.5;
    // pürüzsüz yüzeyde bulut seçilir, pürüz 0,5'te tamamen ortalamaya karışır (kol uniform'a bağlı: mat yüzey ödemez)
    let cl = select(a < 0.25, sample_level(clouds, cloud_uv(r, up), 0).x, 0.0);
    let cover = smoothstep(0.5, 0.68, cl) * clamp(1.0 - a * 4.0, 0.0, 1.0) * smoothstep(0.015, 0.2, r.y);
    return mix(vec3(0.13, 0.11, 0.09), mix(above, vec3(0.9, 0.88, 0.85), cover), clamp((r.y + band) / (2.0 * band), 0.0, 1.0));
}

// GGX güneş yansıması + çevre yansıması. v göze doğru, nl = n·l, vis gölge çarpanı (çevre gölgede de kalır, yalnız güneş kesilir)
fn specular(n: vec3, v: vec3, nl: f32, vis: f32, f0: vec3, sun: vec3, nvar: f32) -> vec3 {
    // geometrik yumuşatma (Kaplanyan 2016): piksel içinde normal ne kadar değişiyorsa lob o kadar geniş; parlak nokta kırpışmaz
    let a = max(rough * rough, 0.002);
    let a2 = a * a + min(nvar, 0.18);
    let h = norm_safe(v + to_light);
    let ndh = clamp(dot(n, h), 0.0, 1.0);
    let ndv = clamp(dot(n, v), 0.0001, 1.0);
    let ndl = clamp(nl, 0.0, 1.0);
    let q = ndh * ndh * (a2 - 1.0) + 1.0;
    let d = a2 / max(3.14159265 * q * q, 0.000001);
    // Smith, yüksekliğe bağlı (Hammon yaklaşımı): V = 0,5 / mix(2·nl·nv, nl + nv, a)
    let vis_g = 0.5 / max(mix(2.0 * ndl * ndv, ndl + ndv, a), 0.0001);
    let m = 1.0 - clamp(dot(v, h), 0.0, 1.0);
    let m2 = m * m;
    let fr = f0 + (vec3(1.0) - f0) * (m2 * m2 * m);
    let direct = fr * (d * vis_g * ndl * vis * 3.14159265);
    // çevre: DFG integralinin analitik yaklaşımı (Karis 2014)
    let c0 = rough * -1.0 + 1.0;
    let c1 = rough * -0.0275 + 0.0425;
    let c2 = rough * -0.572 + 1.04;
    let c3 = rough * 0.022 - 0.04;
    let a004 = min(c0 * c0, exp2(-9.28 * ndv)) * c0 + c1;
    let env = f0 * (-1.04 * a004 + c2) + vec3(1.04 * a004 + c3);
    return direct * sun + sky_linear(reflect(-v, n), rough) * env;
}

// ACES film eğrisi (Narkowicz 2015): parlak uçta yumuşak doyum
fn tone(x: f32) -> f32 {
    return sqrt(clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0));
}

fn frag() -> vec4 {
    let texel = sample_aniso(uv);
    let n0 = norm_safe(nrm);
    // yükseklik: parlaklık + pah (D55, use_mip bit 2): kutu yüzü dokuya tam oturur, uv kenarında çeyrek daire iner, kenar ışık yakalar.
    // Analitik: doku okuması yok (alfadan okumak süzmenin her dokunuşunda bir kanal daha demekti, gölgeleme ×1,45)
    // türevler dalın dışında (D43: türevli kol GPU'da dallanamaz); sample_aniso'nunkilerle aynı IR, CSE paylaştırır
    let foot = abs(dFdx(uv)) + abs(dFdy(uv));
    let height = dot(texel.rgb, vec3(0.3, 0.6, 0.1)) + select((use_mip & 2) != 0, bevel(uv, foot), 0.0) * 1.6;
    let n = select(bump > 0.0, bump_normal(n0, dFdx(wpos), dFdy(wpos), dFdx(height), dFdy(height)), n0);
    let nl = dot(n, to_light);
    // fizik alanı (D49): fizik modülü yazar, malzeme tepki verir. R gerilme: lif açılır, renk açılır ve ışık daha çok geçer. G katlanma: kat içine
    // ortam ışığı girmez (boşluk gölgesi)
    // geniş zemin quad başına okur (D53, 16 piksele bir); küçük cisim (bit 4: bayrak, jöle) piksel başına: kıvrım gölgesi 2×2 basamak olmaz (D58).
    // İki koşul da uniform → gerçek dal, seçilmeyen okuma çalışmaz
    let fuv = fract(uv * field_scale);
    let phys = select(field_scale > 0.0, select((use_mip & 4) != 0, sample_level(field, fuv, 0), sample_level(field, quad0(fuv), 0)), vec4(0.0));
    // alan tekrar eder, temas gölgesi tekrar etmemeli: 62 m'lik karenin dışında G yok
    let fold = select(abs(wpos.x) < 31.0 && abs(wpos.z) < 31.0, phys.y, 0.0);
    // görüntü → doğrusal (gama 2): doku, renk ve ışık sayıları sRGB görünümünde verilir
    // B zemin lekesi (D53): döşeme tekrarını kırar
    let base = mix(texel.rgb * tint, vec3(1.0), phys.x * 0.18) * (1.0 - phys.z * 0.2);
    let albedo = base * base;
    let sun = light_color * light_color * 1.75;
    // yumuşak diffuse: Lambert ile half-Lambert² arası (wrap = 0 → Lambert, 1 → ((n·l)/2 + 1/2)²).
    // Kare, gölge tarafını kara basmadan kıvrımlardaki eğim farkını korur → kıvrımlar belli olur.
    let h = nl * 0.5 + 0.5;
    let diffuse = mix(max(nl, 0.0), h * h, wrap);
    // arkadan ışık (ters yüz aydınlanır), yumuşak
    let back = max(-nl, 0.0) * translucency * (1.0 + phys.x * 1.5);
    // bulut gölgesi (D53): 256 m'lik doku, gökle aynı rüzgâr; yalnız doğrudan güneşi kısar. Gölge haritasından bağımsız
    let shadowed = select(SHADOWS, shadow_lit(wpos, n0), 1.0);
    let vis = shadowed * cloud_sun(wpos);
    // yarım küre ortam: tepe gök, dip zemin (doğrusal ışıma)
    // gölge düşen yer gökyüzünün bir kısmını da görmez (D52): ek okuma yok, gölge çarpanı ortamı %22'ye kadar kısar
    // yere yakın dik ve alt yüzey göğün yarısını zemin olarak görür, dipte kararır (D53): okuma yok; üst yüzey etkilenmez
    let ground_ao = mix(clamp(wpos.y * 1.5 + 0.5, 0.0, 1.0), 1.0, clamp(n.y, 0.0, 1.0));
    let hemi = mix(vec3(0.34, 0.29, 0.23), vec3(0.66, 0.76, 0.92), n.y * 0.5 + 0.5) * (ambient * 1.3 * (1.0 - fold * 0.75) * (0.78 + 0.22 * shadowed) * ground_ao);
    let to_eye = eye - wpos;
    let d = length(to_eye);
    let v = to_eye * (1.0 / max(d, 0.0001));
    let lit = albedo * (1.0 - metal) * (hemi + sun * (diffuse * vis * (1.0 - fold * 0.3) + back));
    let f0 = mix(vec3(0.04), albedo, metal);
    let dnx = dFdx(n);
    let dny = dFdy(n);
    let nvar = dot(dnx, dnx) + dot(dny, dny);
    let c = lit + select(rough < 0.97, specular(n, v, nl, vis, f0, sun, nvar), vec3(0.0));
    // Beer-Lambert: e = 2^(-kx²) kırmızıda, yeşil ×1,25, mavi ×1,5 üstel; ufukta gök rengine erir
    let x = fog_depth(d);
    let e = exp2(-2.5 * x * x);
    let s4 = sqrt(sqrt(e));
    let eg = e * s4;
    let eb = e * s4 * s4;
    return vec4(mix(fog_color.x, tone(c.x), e), mix(fog_color.y, tone(c.y), eg), mix(fog_color.z, tone(c.z), eb), 1.0);
}
